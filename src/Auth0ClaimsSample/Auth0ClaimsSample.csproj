<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Auth0ClaimsSample</RootNamespace>
    <UserSecretsId>auth0-claims-sample-lisa</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auth0 ASP.NET Core SDK. 1.11.0 is the latest stable at time of writing
         and supports net6.0/7.0/8.0/10.0. -->
    <PackageReference Include="Auth0.AspNetCore.Authentication" Version="1.11.0" />
  </ItemGroup>

</Project>
